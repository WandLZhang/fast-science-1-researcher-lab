# blueprints/research-delegation/project-templates/sandbox-project.yaml.sample
#
# Sandbox project — for newcomers exploring GCP, running tutorials, or
# trying out tools before committing to a hardened production setup.
#
# Defaults are loose: public IPs allowed, default VPC permitted, OS Login not
# required, no service-allowlist, no lien (so the project can be deleted
# easily when the experiment is over). Per-project org-policy OVERRIDES below
# explicitly loosen the constraints inherited from the Teams folder baseline.
#
# To create a sandbox project:
#   1. Copy this file into the L1 PF data dir:
#        cp blueprints/research-delegation/project-templates/sandbox-project.yaml.sample \
#           fast/stages-aw/3-project-factory-prod/data/projects/<dept>-<pi>-sandbox.yaml
#   2. Replace every <PLACEHOLDER>.
#   3. Apply:
#        cd fast/stages-aw/3-project-factory-prod
#        terraform plan
#        terraform apply
#
# The filename (without .yaml) becomes the project name suffix:
#   <dept>-<pi>-sandbox.yaml → creates project: <prefix>-<dept>-<pi>-sandbox

# Place the project under the PI's subfolder (or the department folder if no
# PI subfolders are in use). Find the folder ID with:
#   gcloud resource-manager folders list --folder=<TEAMS_FOLDER_ID>
parent: folders/<DEPT_OR_PI_FOLDER_ID>

# Master institution billing account
billing_account: <BILLING_ACCOUNT_ID>

labels:
  template: sandbox
  environment: sandbox
  department: <DEPT_KEY>
  pi: <PI_USERNAME>
  cost-center: "<COST_CENTER>"

# Generous service set — sandbox users can enable common research APIs without
# IT round-trips. Add more if your sandbox use cases need them.
services:
  - cloudresourcemanager.googleapis.com
  - serviceusage.googleapis.com
  - iam.googleapis.com
  - iamcredentials.googleapis.com
  - logging.googleapis.com
  - monitoring.googleapis.com
  - compute.googleapis.com
  - storage.googleapis.com
  - bigquery.googleapis.com
  - bigquerystorage.googleapis.com
  - aiplatform.googleapis.com
  - notebooks.googleapis.com
  - artifactregistry.googleapis.com
  - cloudbuild.googleapis.com
  - container.googleapis.com
  - run.googleapis.com
  - cloudfunctions.googleapis.com
  - pubsub.googleapis.com
  - workflows.googleapis.com

# Per-project org-policy OVERRIDES that loosen the Teams folder baseline.
# Each override applies only to this project and does not affect siblings.
# These work because the PI / dept admin group has roles/orgpolicy.policyAdmin
# at the team folder level (granted in ../team-folders/team-folders.example.tfvars).
org_policies:

  # Allow public IPs on VMs — handy for testing internet-facing services.
  compute.vmExternalIpAccess:
    rules:
      - allow:
          all: true

  # Don't require OS Login — lets newcomers follow tutorials that use legacy
  # SSH keys. Trade-off: SSH sessions are not Google-identity-mapped.
  compute.requireOsLogin:
    rules:
      - enforce: false

  # Allow the auto-created `default` VPC network so newcomers can run "VM in
  # 5 minutes" tutorials without learning Shared VPC first.
  compute.skipDefaultNetworkCreation:
    rules:
      - enforce: false

  # Don't restrict which APIs can be enabled. Newcomers can experiment with
  # any GA Google Cloud API.
  gcp.restrictServiceUsage:
    rules:
      - allow:
          all: true

# NO lien_reason — sandbox projects should be easy to delete when done.

# Budget cap with alerts so a forgotten sandbox doesn't run away. Adjust the
# amount; default is intentionally low ($100/mo) to bound exploration cost.
billing_budgets:
  - sandbox-cap

# Workload SA the PI uses for any quick scripts they run. Logs to project,
# nothing more — they can self-grant additional roles since they hold
# folderAdmin / projectCreator on the parent.
service_accounts:
  sandbox-runner-0:
    display_name: "Sandbox runner SA. PI may add roles as needed."
    iam_self_roles:
      - roles/logging.logWriter
      - roles/monitoring.metricWriter

# Essential contact: the PI gets billing / technical / legal notifications.
contacts:
  pi-name@<UNIVERSITY_DOMAIN>:
    - BILLING
    - TECHNICAL

# NOTE: a corresponding billing-budgets YAML must exist at
#   fast/stages-aw/3-project-factory-prod/data/budgets/sandbox-cap.yaml
# with content like:
#   amount:
#     units: 100
#   threshold_rules:
#     - threshold_percent: 0.5
#     - threshold_percent: 0.9
#     - threshold_percent: 1.0
