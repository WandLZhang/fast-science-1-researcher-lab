# use `gcloud billing accounts list`
billing_account = {
  id = "<billing_account_id>" # taken from Google Cloud Console Billing Accounts -> Manage Billing Account
}

# Optional Billing budget for the Assured Workload folder. If not set, no budget will be created.
# billing_budget_amount = {
#   amount = 1000
# }

# Compute region. Drives KMS keyring location and log sink location by default.
# Default to us-east4 for IL5/FedRAMP High/Moderate compliance — adjust as needed.
regions = {
  primary = "us-east4"  # Change to your preferred region
}

# Optional override for the top-level managed folder name. Default:
# "it-services" for unspecified regime; lowercased regime short code
# (e.g., "il5", "frh") for compliance regimes.
# managed_folder_name = "it-services"

# Optional override for the org-level tag key used by L1 for folder-scoped
# org-policy admin delegation. Default "department" works for universities
# (schools/departments), federal agencies (centers), and
# corporate divisions. L1 creates one tag value per team_folders entry and
# binds it to the corresponding department folder.
# department_tag_key_name = "department"

# Optional override for bucket / dataset / keyring locations.
# Defaults: GCS=US, BQ=US (multi-region); logging=global → falls back to regions.primary;
# KMS=null → falls back to regions.primary (KMS requires a regional location or a
# lowercase multi-region like "us"/"europe", NOT the uppercase "US" used by GCS/BQ).
# Uncomment to override:
# locations = {
#   bq      = "US"
#   gcs     = "US"
#   logging = "global"
#   pubsub  = []
#   kms     = "us-east4"   # or "us" for multi-region; do NOT use "US"
# }

# use `gcloud organizations list`
organization = {
  domain      = "<domain>" # DISPLAY_NAME
  id          = "<organization_id>"
  customer_id = "<customer_id>"
}

outputs_location = "~/fast-config"

# Retention period (in days) for organization logging buckets (defaults to 365 days for compliance)
# logging_bucket_retention = 365

# This variable is prepended to the names of all resources that are created.
# Use something unique and no longer than 7 characters
prefix = "<prefix>"

# Default log routing is set to "logging" (Cloud Logging buckets, retained for
# logging_bucket_retention days; the default is 365)
# To use long-term storage, change type to "storage" (GCS) or "bigquery"
# To route to a SIEM, use "pubsub" (note: requires active subscriber to avoid log loss after 7 days)
log_sinks = {
  audit-logs = {
      filter = "logName:\"/logs/cloudaudit.googleapis.com%2Factivity\" OR logName:\"/logs/cloudaudit.googleapis.com%2Fsystem_event\" OR protoPayload.metadata.@type=\"type.googleapis.com/google.cloud.audit.TransparencyLog\""
      type   = "logging"
    }
    vpc-sc = {
      filter = "protoPayload.metadata.@type=\"type.googleapis.com/google.cloud.audit.VpcServiceControlAuditMetadata\""
      type   = "logging"
    }
    workspace-audit-logs = {
      filter = "logName:\"/logs/cloudaudit.googleapis.com%2Fdata_access\" and protoPayload.serviceName:\"login.googleapis.com\""
      type   = "logging"
    }
    
    # CIS Compliance Benchmark 2.2
    empty-audit-logs = {
      filter = ""
      type   = "logging"
    }
}

org_policies_config = {
  import_defaults = false # No policies to import as of 27 SEP 2024
  # Brownfield orgs: list the org policies your organization already has (for
  # example from Google Cloud Setup or Foundation Builder). The second apply
  # imports them instead of failing with ALREADY_EXISTS, then sets them to this
  # stage's values. List them with:
  #   gcloud org-policies list --organization=<organization_id> --format='value(name.basename())'
  # Constraints this stage doesn't manage are skipped with a warning. The example
  # is the Foundation Builder baseline from github.com/google/skills, minus
  # compute.restrictXpnProjectLienRemoval, which this stage doesn't set.
  # import_existing = [
  #   "compute.disableNestedVirtualization",
  #   "compute.disableSerialPortAccess",
  #   "compute.disableVpcExternalIpv6",
  #   "compute.requireOsLogin",
  #   "compute.restrictProtocolForwardingCreationForTypes",
  #   "compute.setNewProjectDefaultToZonalDNSOnly",
  #   "compute.vmExternalIpAccess",
  #   "essentialcontacts.allowedContactDomains",
  #   "iam.allowedPolicyMemberDomains",
  #   "iam.automaticIamGrantsForDefaultServiceAccounts",
  #   "iam.disableServiceAccountKeyCreation",
  #   "iam.disableServiceAccountKeyUpload",
  #   "sql.restrictAuthorizedNetworks",
  #   "sql.restrictPublicIp",
  #   "storage.publicAccessPrevention",
  #   "storage.uniformBucketLevelAccess",
  # ]
  constraints = {
    allowed_policy_member_domains = [] #Update with additional customer IDs if needed
  }
}

fast_features = {
  envs = true
}

# Regime must be in all caps
assured_workloads = {
  regime = "<compliance_regime>" #"IL4, IL5, FEDRAMP_HIGH, etc... if you wish to not use assured_workloads, set this value to COMPLIANCE_REGIME_UNSPECIFIED"
  location = "<region>" # Uses the same region as other resources for consistency - change to match your regions.primary if different
}

bootstrap_project = "<bootstrap_project_id>"

alert_email = "<alert_email>"

# KMS protection level for CMEK keys. Leave unset to get a regime-aware default:
# SOFTWARE for FEDRAMP_MODERATE, HSM for all other regimes (including FEDRAMP_HIGH and IL5).
# Explicitly set to "SOFTWARE" or "HSM" to override the default.
# kms_protection_level = "HSM"
